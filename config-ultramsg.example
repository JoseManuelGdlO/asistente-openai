# Configuración de variables de entorno para UltraMsg
# Copia este archivo como .env y llena los valores

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# UltraMsg Configuration (reemplaza Meta/WhatsApp)
ULTRAMSG_TOKEN=your-ultramsg-token-here
ULTRAMSG_INSTANCE_ID=your-instance-id-here
ULTRAMSG_WEBHOOK_TOKEN=your-webhook-token-here

# ==================== CONFIGURACIÓN DE FIREBASE ====================
# Obtén estas credenciales desde la consola de Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ==================== CLIENTES ====================
# Los consultorios viven en Firestore: clients/{id} + Assistants/{id}
# Seed: npm run create-assistant (SEED_CLIENT_ID, SEED_ADMIN_PHONE, etc.)

# ==================== ADMIN API ====================
# Token para documentos y gestión de sesiones
# Header: Authorization: Bearer <token>  o  x-admin-token: <token>
ADMIN_API_TOKEN=change-me-to-a-long-random-secret

# Server Configuration
PORT=3000
